{
  "name": "Dixipolis — Get Transcription Status",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "transcriptions/:job_id",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-get",
      "name": "Webhook GET /transcriptions/:job_id",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract the runpod_job_id from the path parameter\n// The job_id from our system maps to a runpod job id\n// For simplicity, we use the runpod_job_id directly\nconst params = $input.first().json.params || {};\nconst query = $input.first().json.query || {};\nconst job_id = params.job_id || query.job_id;\n\nif (!job_id) {\n  throw new Error('job_id is required');\n}\n\nreturn [{\n  json: { job_id }\n}];"
      },
      "id": "extract-job-id",
      "name": "Extract Job ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.runpod.ai/v2/YOUR_RUNPOD_ENDPOINT_ID/status/{{ $json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_RUNPOD_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "check-runpod-status",
      "name": "Check Runpod Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format the response based on Runpod status\nconst runpod = $input.first().json;\nconst job_id = $('Extract Job ID').first().json.job_id;\n\n// Runpod statuses: IN_QUEUE, IN_PROGRESS, COMPLETED, FAILED, CANCELLED, TIMED_OUT\nconst status = runpod.status;\n\nconst result = {\n  job_id,\n  status,\n};\n\nif (status === 'COMPLETED' && runpod.output) {\n  // Return the full transcript\n  result.transcript = runpod.output;\n} else if (status === 'FAILED') {\n  result.error = runpod.error || 'Job failed';\n}\n\nreturn [{ json: result }];"
      },
      "id": "format-status",
      "name": "Format Status Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-status",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 300]
    }
  ],
  "connections": {
