{
  "name": "Dixipolis — Serve Audio Files",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "audio/:filename",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-audio",
      "name": "Webhook GET /audio/:filename",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "filePath": "=/data/audio/{{ $json.params.filename }}",
        "options": {}
      },
      "id": "read-file",
      "name": "Read Audio File",
      "type": "n8n-nodes-base.readBinaryFiles",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "audio/wav"
              }
            ]
          }
        }
      },
      "id": "respond-audio",
      "name": "Respond with Audio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Webhook GET /audio/:filename": {
      "main": [
        [{ "node": "Read Audio File", "type": "main", "index": 0 }]
      ]
    },
    "Read Audio File": {
      "main": [
        [{ "node": "Respond with Audio", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
