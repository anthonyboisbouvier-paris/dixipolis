# =============================================================================
# Variables d'environnement — Dixipolis
#
# Copiez ce fichier en .env.local et remplissez les valeurs.
# ATTENTION : ne jamais committer .env.local (il est dans .gitignore).
# =============================================================================

# --- URL publique du site (utilisee pour le sitemap, OG tags, etc.) ---
NEXT_PUBLIC_SITE_URL=https://dixipolis.vercel.app

# --- Runpod (pipeline transcription GPU) ---
RUNPOD_API_KEY=rpa_xxxxx
RUNPOD_ENDPOINT_ID=xxxxx

# --- HuggingFace (pour pyannote diarisation) ---
HF_TOKEN=hf_xxxxx

# --- n8n (orchestrateur webhooks) ---
N8N_URL=https://your-n8n-instance.com
N8N_API_KEY=eyJ...

# --- Supabase (stockage transcriptions) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
